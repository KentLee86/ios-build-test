<Window
    x:Class="Arm64NativeAotDemo.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Arm64NativeAotDemo.Views"
    x:CompileBindings="True"
    Title="ARM64 NativeAOT Demo"
    Width="960"
    Height="600"
    MinWidth="800"
    MinHeight="500"
    Background="#07111F"
    CanResize="False"
    WindowStartupLocation="CenterScreen">
  <views:MainView />
</Window>
